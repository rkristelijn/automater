{
  "name": "automater",
  "version": "1.0.2",
  "description": "Scaffold modern web apps with best practices in seconds",
  "type": "module",
  "bin": {
    "automater": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cd examples/opennext-mui-toolpad && pnpm dev",
    "preregenerate:examples": "tsc",
    "regenerate:examples": "rm -rf examples/opennext-mui-toolpad && echo 'Starting generator...' && node dist/cli.js create examples/opennext-mui-toolpad --features=mui-toolpad",
    "example:toolpad": "npx --yes create-toolpad-app@latest --example tutorial tmp/example-toolpad",
    "example:vercel": "npx --yes create-next-app@latest tmp/example-vercel --example blog-starter",
    "example:cloudflare": "npx --yes create-next-app --example with-static-export tmp/example-cloudflare"
  },
  "keywords": [
    "cli",
    "scaffold",
    "generator",
    "nextjs",
    "vite",
    "react"
  ],
  "author": "Remi Kristelijn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rkristelijn/automater.git"
  },
  "homepage": "https://github.com/rkristelijn/automater#readme",
  "bugs": {
    "url": "https://github.com/rkristelijn/automater/issues"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
